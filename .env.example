# Copy to .env and adjust. Never commit .env.

# --- Application ---
ATP_ENVIRONMENT=development          # development | staging | production
ATP_LOG_LEVEL=INFO
ATP_TRADING_MODE=paper               # paper | live (live requires ATP_ENVIRONMENT=production)

# --- PostgreSQL / TimescaleDB ---
ATP_DATABASE__HOST=localhost
ATP_DATABASE__PORT=5432
ATP_DATABASE__USER=atp
ATP_DATABASE__PASSWORD=atp
ATP_DATABASE__NAME=atp

# --- Redis ---
ATP_REDIS__HOST=localhost
ATP_REDIS__PORT=6379
ATP_REDIS__DB=0

# --- docker-compose (containers read these directly) ---
POSTGRES_USER=atp
POSTGRES_PASSWORD=atp
POSTGRES_DB=atp
