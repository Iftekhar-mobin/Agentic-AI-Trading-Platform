# Copy to .env and adjust. Never commit .env.

# --- Application ---
ATP_ENVIRONMENT=development          # development | staging | production
ATP_LOG_LEVEL=INFO
ATP_TRADING_MODE=paper               # paper | live (live requires ATP_ENVIRONMENT=production)

# --- PostgreSQL / TimescaleDB ---
ATP_DATABASE__HOST=localhost
ATP_DATABASE__PORT=5432
ATP_DATABASE__USER=atp
ATP_DATABASE__PASSWORD=atp
ATP_DATABASE__NAME=atp

# --- Paper portfolio & risk limits ---
ATP_DATA_DIR=data
ATP_PAPER_STARTING_CASH=100000
ATP_RISK__MAX_RISK_PER_TRADE_PCT=1.0
ATP_RISK__MAX_POSITION_PCT=20.0
ATP_RISK__MAX_TOTAL_EXPOSURE_PCT=100.0
ATP_RISK__MAX_POSITIONS=10
ATP_RISK__MAX_DAILY_LOSS_PCT=3.0
ATP_RISK__MAX_DRAWDOWN_PCT=20.0
ATP_RISK__REQUIRE_STOP_LOSS=true
ATP_EXECUTION__SLIPPAGE_BPS=5.0

# --- News & sentiment ---
ATP_NEWS__LOOKBACK_DAYS=7
ATP_NEWS__LIMIT=20
ATP_NEWS__CACHE_TTL_SECONDS=300      # 0 disables the shared news cache
# lexicon (default, offline) | finbert (needs `uv sync --extra finbert`)
ATP_SENTIMENT__MODEL=lexicon
ATP_SENTIMENT__FINBERT_MODEL_NAME=ProsusAI/finbert
ATP_SENTIMENT__HALF_LIFE_DAYS=3.0    # age at which an article carries half weight

# --- LLM (Anthropic) ---
# Key resolution: ATP_LLM__ANTHROPIC_API_KEY, else the SDK's own environment
# lookup (ANTHROPIC_API_KEY or an `ant auth login` profile).
#ATP_LLM__ANTHROPIC_API_KEY=sk-ant-...
ATP_LLM__MODEL=claude-opus-4-8
ATP_LLM__MAX_TOKENS=16000

# --- Episodic memory ---
ATP_MEMORY__BACKEND=json             # json (offline default) | qdrant
ATP_MEMORY__EMBEDDING_DIMENSIONS=256 # changing this invalidates stored vectors
ATP_MEMORY__RECALL_LIMIT=5
ATP_MEMORY__QDRANT_URL=http://localhost:6333
ATP_MEMORY__QDRANT_COLLECTION=atp_episodes

# --- Redis ---
ATP_REDIS__HOST=localhost
ATP_REDIS__PORT=6379
ATP_REDIS__DB=0

# --- docker-compose (containers read these directly) ---
POSTGRES_USER=atp
POSTGRES_PASSWORD=atp
POSTGRES_DB=atp
