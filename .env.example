# Copy to .env and adjust. Never commit .env.

# --- Application ---
ATP_ENVIRONMENT=development          # development | staging | production
ATP_LOG_LEVEL=INFO
ATP_TRADING_MODE=paper               # paper | live (live requires ATP_ENVIRONMENT=production)

# --- PostgreSQL / TimescaleDB ---
ATP_DATABASE__HOST=localhost
ATP_DATABASE__PORT=5432
ATP_DATABASE__USER=atp
ATP_DATABASE__PASSWORD=atp
ATP_DATABASE__NAME=atp

# --- Paper portfolio & risk limits ---
ATP_DATA_DIR=data
ATP_PAPER_STARTING_CASH=100000
ATP_RISK__MAX_RISK_PER_TRADE_PCT=1.0
ATP_RISK__MAX_POSITION_PCT=20.0
ATP_RISK__MAX_TOTAL_EXPOSURE_PCT=100.0
ATP_RISK__MAX_POSITIONS=10
ATP_RISK__MAX_DAILY_LOSS_PCT=3.0
ATP_RISK__MAX_DRAWDOWN_PCT=20.0
ATP_RISK__REQUIRE_STOP_LOSS=true
ATP_EXECUTION__SLIPPAGE_BPS=5.0

# --- News & sentiment ---
ATP_NEWS__LOOKBACK_DAYS=7
ATP_NEWS__LIMIT=20
ATP_NEWS__CACHE_TTL_SECONDS=300      # 0 disables the shared news cache
# lexicon (default, offline) | finbert (needs `uv sync --extra finbert`)
ATP_SENTIMENT__MODEL=lexicon
ATP_SENTIMENT__FINBERT_MODEL_NAME=ProsusAI/finbert
ATP_SENTIMENT__HALF_LIFE_DAYS=3.0    # age at which an article carries half weight

# --- LLM providers ---
# anthropic (paid, best) | openrouter (free tier) | ollama (local, free)
ATP_LLM__PROVIDER=openrouter
ATP_LLM__MAX_TOKENS=16000
# Set false to pin the model at deploy time (POST /models/select then 409s).
ATP_LLM__ALLOW_RUNTIME_MODEL_SWITCHING=true

# Anthropic. Key resolution: ATP_LLM__ANTHROPIC_API_KEY, else the SDK's own
# environment lookup (ANTHROPIC_API_KEY or an `ant auth login` profile).
#ATP_LLM__ANTHROPIC_API_KEY=sk-ant-...
ATP_LLM__MODEL=claude-opus-4-8

# OpenRouter. Free account key at https://openrouter.ai/keys.
# Models ending ':free' cost nothing but are rate-limited and schema-sloppier.
# The free roster changes without notice; check the Models page for what is
# live, and prefer a model of 100B+ parameters - smaller ones drop required
# fields and surface as agent failures.
#ATP_LLM__OPENROUTER_API_KEY=sk-or-...
ATP_LLM__OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Ollama. Install from ollama.com, run `ollama serve`. No key, no cost.
ATP_LLM__OLLAMA_BASE_URL=http://localhost:11434
ATP_LLM__OLLAMA_MODEL=llama3.1:8b

# --- API security ---
# JSON list of credentials. Required when ATP_ENVIRONMENT=production.
# Scopes: "read" (analysis, portfolio, orders, memory) and "trade" (POST /trade).
#ATP_API__KEYS=[{"name":"dashboard","key":"change-me","scopes":["read"]},{"name":"trader","key":"change-me-too","scopes":["read","trade"]}]
ATP_API__RATE_LIMIT_PER_MINUTE=60    # 0 disables the limiter
#ATP_API__CORS_ORIGINS=["http://localhost:8501"]

# --- Observability ---
# Tracing stays off until an OTLP endpoint is set.
#ATP_OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4318/v1/traces
ATP_OBSERVABILITY__SERVICE_NAME=atp
ATP_OBSERVABILITY__TRACE_SAMPLE_RATIO=1.0

# --- Consensus voting (bot + agents) ---
# See docs/BOT_INTEGRATION.md. score = SUM(dir*conf)/SUM(conf), in [-1, 1].
ATP_VOTING__THRESHOLD=0.35           # minimum |score| to act; below this, hold
ATP_VOTING__MIN_VOTERS=3             # quorum for any non-hold verdict
ATP_VOTING__REQUIRE_BOT_SIGNAL=false # true = agents may never act without the bot
ATP_VOTING__SIGNAL_TTL_SECONDS=900   # how long a bot signal stays eligible to vote
# Naming the bot turns its silence into a reported status instead of an
# unnoticed absence ("sniper_bot is not available - deciding on agents alone").
#ATP_VOTING__EXPECTED_BOT=sniper_bot

# --- Market research ---
# The benchmark relative strength is measured against.
ATP_RESEARCH__BENCHMARK=SPY

# --- Episodic memory ---
ATP_MEMORY__BACKEND=json             # json (offline default) | qdrant
ATP_MEMORY__EMBEDDING_DIMENSIONS=256 # changing this invalidates stored vectors
ATP_MEMORY__RECALL_LIMIT=5
ATP_MEMORY__QDRANT_URL=http://localhost:6333
ATP_MEMORY__QDRANT_COLLECTION=atp_episodes

# --- Redis ---
ATP_REDIS__HOST=localhost
ATP_REDIS__PORT=6379
ATP_REDIS__DB=0

# --- docker-compose (containers read these directly) ---
POSTGRES_USER=atp
POSTGRES_PASSWORD=atp
POSTGRES_DB=atp
